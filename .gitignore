# macOS
.DS_Store

# Go
coverage.out
coverage.html
bin/

# Devnet runtime state (PIDs, logs, test keypairs)
.devnet/

# Release packaging output
dist/

# Machine-specific devnet output. Regenerated by `make init-test-chain`
# (devnet/chain/generate-genesis-keys.sh), which derives every path from
# ${TIMEFLARE_HOME:-$HOME/.timeflare} — so a committed copy hard-codes one
# machine's home directory and is wrong everywhere else.
devnet/chain/genesis-addresses.conf

# Vendored buf dependency exports. Produced by make/scripts/export-buf-deps.sh
# for editor/IDE proto resolution; buf itself resolves deps from buf.lock via
# the BSR and never reads this tree (buf.yaml declares only `modules: proto`).
# Committing it creates ~200 files that can silently drift from buf.lock.
third_party/

# Devnet claim lock. There is one devnet on this machine — ~/.timeflare, the
# installed timeflared and the running node are machine-global — so concurrent
# sessions (including a monorepo checkout) coordinate through this file before
# dev-up, dev-reset, e2e or anything else that drives the chain. It is
# coordination between sessions, not history: it must never reach a branch.

# Claude Code worktrees — machine-local execution checkouts, never history.
# Deliberately narrow: .claude/settings.json, agents and skills stay committable.
.claude/worktrees/
